           var start = desc?.IndexOf("<!") ?? -1;
           var end = desc?.IndexOf("!>") ?? -1;
           if (desc != null && isEnum && start >=0 && end >=0)
           {
               var key = desc.Substring(start + 2, end - start - 2);
               enums[name].Add(key,value);
               desc = desc.Replace($"<!{key}!>", string.Empty);
               value = $"{name}.{key}";
           }
#>
                new ValueTuple<MavParamValue, string>((<#= netType #>)<#= value #>, "<#= desc #>"),
<#
       }
#>
            ],
            Bitmask = [
<#
       foreach (var bit in GetJsonObjects(obj, "bitmask"))
       {
#>
                new MavParamBitmask { Index = <#= GetJsonValue(bit, "index") #>, Description = "<#= GetJsonValue(bit, "description") #>" },
<#
       }
#>
            ]
        };
<#
     }
