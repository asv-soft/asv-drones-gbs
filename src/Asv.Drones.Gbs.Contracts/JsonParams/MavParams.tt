<#+
  private string LoadJson(string path) {
    return File.ReadAllText(path);
  }

  private IEnumerable<string> GetJsonObjects(string json, string arrayName) {
    var arrayStart = json.IndexOf($"\"{arrayName}\":");
    if (arrayStart == -1) yield break;
    arrayStart = json.IndexOf('[', arrayStart);
    var arrayEnd = json.LastIndexOf(']');
    if (arrayStart < 0 || arrayEnd < 0) yield break;

    var arrayContent = json.Substring(arrayStart + 1, arrayEnd - arrayStart - 1).Trim();

    int depth = 0;
    int startIndex = 0;
    bool inString = false;

    for (int i = 0; i < arrayContent.Length; i++) {
      char c = arrayContent[i];
      if (c == '"' && (i == 0 || arrayContent[i - 1] != '\\')) {
        inString = !inString;
      }
      if (inString) continue;
      if (c == '{') {
        if (depth == 0) startIndex = i;
        depth++;
      } else if (c == '}') {
        depth--;
        if (depth == 0) {
          yield return arrayContent.Substring(startIndex, i - startIndex + 1);
        }
      }
    }
  }

  private string GetJsonValue(string json, string key)
{
    if (string.IsNullOrEmpty(json) || string.IsNullOrEmpty(key))
        return null;

    int keyPos = json.IndexOf($"\"{key}\":");
    if (keyPos == -1)
        return null;

    // Находим начало значения, пропуская пробелы после двоеточия
    int start = json.IndexOf(':', keyPos) + 1;
    while (start < json.Length && char.IsWhiteSpace(json[start]))
        start++;

    if (start >= json.Length)
        return null; // JSON обрывается после двоеточия

    int end = start;
    int braceDepth = 0;
    bool inString = false;

    while (end < json.Length)
    {
        char c = json[end];

        // Проверяем, внутри ли мы строки, учитывая экранирование
        if (c == '"' && end > 0)
        {
            int slashes = 0;
            for (int i = end - 1; i >= 0 && json[i] == '\\'; i--)
                slashes++;
            if (slashes % 2 == 0) // Чётное число слешей — это не экранирование
                inString = !inString;
        }
        else if (end == start && c == '"') // Первая кавычка без предшествующих символов
            inString = true;

        if (!inString)
        {
            if (c == '{' || c == '[')
                braceDepth++;
            else if (c == '}' || c == ']')
            {
                braceDepth--;
                if (braceDepth < 0) // Конец объекта или массива
                    break;
            }
            else if (braceDepth == 0 && (c == ',' || c == '}'))
                break; // Конец значения на том же уровне вложенности
        }
        end++;
    }

    // Если braceDepth != 0, значит, JSON некорректен, но мы всё равно возвращаем результат до конца строки
    if (end > json.Length)
        end = json.Length;
 
    string value = json.Substring(start, end - start).Trim(' ', '\t', '\n', '\r');

    // Убираем кавычки только для строковых значений
    if (value.StartsWith("\"") && value.EndsWith("\"") && value.Length >= 2)
        return value.Substring(1, value.Length - 2);

    return value;
}

  
  private string GetMavTypeName(string json, string key) {
    var type = GetJsonValue(json, key);
    return type switch {
      "Uint8" => "MavParamTypeUint8",
      "Int8" => "MavParamTypeInt8",
      "Uint16" => "MavParamTypeUint16",
      "Int16" => "MavParamTypeInt16",
      "Uint32" => "MavParamTypeUint32",
      "Int32" => "MavParamTypeInt32",
      "Float" => "MavParamTypeReal32",
      _ => type
    };
  }
  public static string ConvertToPascalCase(string input)
  {
    var parts = input.Split('_');
    return string.Concat(parts.Select(part => 
      char.ToUpper(part[0]) + part.Substring(1).ToLower()));
  }
  
  private string GetNetTypeName(string json, string key) {
    var type = GetJsonValue(json, key);
    return type switch {
      "Uint8" => "byte",
      "Int8" => "sbyte",
      "Uint16" => "ushort",
      "Int16" => "short",
      "Uint32" => "uint",
      "Int32" => "int",
      "Float" => "float",
      _ => type
      };
  }
#>
