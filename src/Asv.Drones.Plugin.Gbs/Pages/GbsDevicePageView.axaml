<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:gbs="clr-namespace:Asv.Drones.Plugin.Gbs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Asv.Drones.Plugin.Gbs.GbsDevicePageView"
             x:DataType="gbs:GbsDevicePageViewModel">
    <Design.DataContext>
        <gbs:GbsDevicePageViewModel/>
    </Design.DataContext>
    <DockPanel>
        <Button DockPanel.Dock="Left" Content="kjsdnf"></Button>
    </DockPanel>
</UserControl>
