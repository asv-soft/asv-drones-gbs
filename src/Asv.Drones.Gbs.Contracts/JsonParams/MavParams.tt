        {
            Group = "<#= GetJsonValue(obj, "group") #>",
            Category = "<#= GetJsonValue(obj, "category") #>",
            ShortDesc = "<#= GetJsonValue(obj, "shortDesc") #>",
            LongDesc = "<#= longDesc #>",
            Units = "<#= GetJsonValue(obj, "units") #>",
            RebootRequired = <#= GetJsonValue(obj, "rebootRequired") #>,
