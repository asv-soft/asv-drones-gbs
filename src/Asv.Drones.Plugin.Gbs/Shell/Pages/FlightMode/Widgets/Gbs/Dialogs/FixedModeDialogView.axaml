<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:avalonia="clr-namespace:Asv.Avalonia;assembly=Asv.Avalonia"
    xmlns:gbs="clr-namespace:Asv.Drones.Plugin.Gbs"
    mc:Ignorable="d"
    d:DesignWidth="515"
    d:DesignHeight="750"
    x:Class="Asv.Drones.Plugin.Gbs.FixedModeDialogView"
    x:CompileBindings="True"
    x:DataType="gbs:FixedModeDialogViewModel"
>
    <Design.DataContext>
        <gbs:FixedModeDialogViewModel />
    </Design.DataContext>
    <avalonia:PropertyEditorView DataContext="{Binding FieldsEditor}" />
</UserControl>
