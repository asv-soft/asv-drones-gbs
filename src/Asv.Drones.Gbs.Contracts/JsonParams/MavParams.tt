var items = new List<KeyValuePair<string,string>>();
var globalIndex = 0;
foreach (var file in files)
{
    var jsonContent = LoadJson(Host.ResolvePath(file));
    var arr = GetJsonObjects(jsonContent, "parameters").ToArray();
    var localIndex = 0;
    foreach (var item in arr)
    {
        items.Add(
            new KeyValuePair<string, string>(
                $"Global index:[{globalIndex++}] File index:[{localIndex++}] Source:{file}", item));
    }
}

var enums = new Dictionary<string, Dictionary<string, string>>();

foreach (var item in items)
{
    var obj = item.Value;
    var isEnum = false;
    var longDesc = GetJsonValue(obj, "longDesc") ?? string.Empty;
    var name = GetJsonValue(obj, "name") ;
    var netType = GetNetTypeName(obj, "type");
    if (longDesc.Contains("<!GENERATE_ENUM!>"))
    {
        longDesc = longDesc.Replace("<!GENERATE_ENUM!>", string.Empty);
        isEnum = true;
        
        enums.Add(name , new Dictionary<string, string>());
    }
        
#>
